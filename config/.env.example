# Settings of design-kb. Copy this file to config/.env. Never commit config/.env.
# This file lists every key. A secret key has no value here.
# docs/design.md, section "Settings", explains each setting. A real environment variable overrides
# config/.env.

HOST=127.0.0.1
PORT=8000
DATA_DIR=data
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_TIMEOUT_SECONDS=60
SEARCH_RESULT_LIMIT=10
PAGE_SIZE=10
