{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "PowerShell(git *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git restore *)"
    ],
    "ask": [
      "Edit(/docs/specs.md)",
      "Edit(/docs/workflow.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Bash(pip install *)",
      "Bash(python -m pip install *)",
      "Bash(conda install *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(kill *)",
      "Bash(taskkill *)",
      "PowerShell(pip install *)",
      "PowerShell(python -m pip install *)",
      "PowerShell(conda install *)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(Stop-Process *)",
      "PowerShell(taskkill *)"
    ]
  }
}
