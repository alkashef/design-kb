#!/bin/sh
# Run the project's checks before each commit (docs/workflow.md).
# Turn this hook on, one time for each clone: git config core.hooksPath .githooks
# The hook runs the Python that the git setting `hooks.python` names. With no setting, it runs
# `python`, so the conda environment design-kb must be active. Set the path one time for each
# clone, so that a commit also works from a program that does not have the environment active
# (the Source Control panel of VS Code is one). README.md, Setup, gives the command.
python_path=$(git config --get hooks.python)
exec "${python_path:-python}" scripts/check.py
